# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO
# LOG_JSON=true

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3001

# Azure Database for PostgreSQL (leave empty to run without a database).
# postgres:// and postgresql:// are accepted and switched to the asyncpg driver; Azure needs ?ssl=require.
DATABASE_URL=

# Must equal the Next.js app's BETTER_AUTH_SECRET: FastAPI verifies Better Auth session cookies with it.
BETTER_AUTH_SECRET=
