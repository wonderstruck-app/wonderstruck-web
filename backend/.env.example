# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO
# LOG_JSON=true

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3001

# Azure Database for PostgreSQL (leave empty to run without a database).
# postgres:// and postgresql:// are accepted and switched to the asyncpg driver; Azure needs ?ssl=require.
DATABASE_URL=

# Must equal the Next.js app's BETTER_AUTH_SECRET: FastAPI verifies Better Auth session cookies with it.
BETTER_AUTH_SECRET=

# Mira's live voice (Gemini Live on Vertex AI, billed to this project). Leave empty to turn voice off.
# Locally: gcloud auth application-default login && gcloud auth application-default set-quota-project <project>.
# On Cloud Run the service account needs roles/aiplatform.user.
GOOGLE_CLOUD_PROJECT=
# The Live API needs a regional endpoint.
GOOGLE_CLOUD_LOCATION=us-central1
MIRA_LIVE_MODEL=gemini-3.8-live
