// Wonderstruck database schema: the single owner of every table and migration.
// - Better Auth (Next.js) reads and writes the auth models through its Prisma adapter.
// - FastAPI maps the same tables with SQLAlchemy and never migrates them.
// Conventions: PascalCase models / camelCase fields in Prisma, snake_case tables and columns in Postgres.
// Auth ids are text (Better Auth generates them); everything else is a UUIDv7 generated by Postgres or Prisma.
// Every learner-owned row cascades from `User`, so deleting the account deletes the learner's data.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pgvector must be allow-listed on Azure first: server parameter `azure.extensions` = VECTOR.
  extensions = [vector]
}

// ─── Identity (Better Auth core schema; keep field names as Better Auth expects) ─────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  accounts        Account[]
  settings        LearnerSettings?
  interests       UserInterest[]
  savedBlocks     SavedBlock[]
  blockEvents     BlockEvent[]
  learningSession LearningSession[]
  attempts        ActivityAttempt[]
  concepts        UserConcept[]
  evidence        ConceptEvidence[]
  recallItems     RecallItem[]
  recallReviews   RecallReview[]
  memories        LearnerMemory[]
  aiUsage         AiUsage[]

  @@map("user")
}

/// A Better Auth login session (cookie-backed). Not to be confused with `LearningSession`.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ─── Learner preferences ──────────────────────────────────────────────────────────────────────

enum VoicePace {
  relaxed
  natural
  brisk

  @@map("voice_pace")
}

/// One row per learner, created lazily on first settings read/write.
model LearnerSettings {
  userId                 String    @id @map("user_id")
  voiceId                String    @default("mira") @map("voice_id")
  voicePace              VoicePace @default(natural) @map("voice_pace")
  interruptible          Boolean   @default(true)
  keepTranscripts        Boolean   @default(true) @map("keep_transcripts")
  rememberMisconceptions Boolean   @default(true) @map("remember_misconceptions")
  personalizeDiscover    Boolean   @default(true) @map("personalize_discover")
  onboardedAt            DateTime? @map("onboarded_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_settings")
}

model UserInterest {
  userId    String   @map("user_id")
  topicId   String   @map("topic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@map("user_interest")
}

// ─── Content: Discover blocks ─────────────────────────────────────────────────────────────────

model Topic {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocks    LearningBlock[]
  concepts  Concept[]
  interests UserInterest[]

  @@map("topic")
}

enum BlockStatus {
  draft
  published
  retired

  @@map("block_status")
}

/// A Discover card and its reading page. `body` is ordered storytelling paragraphs.
model LearningBlock {
  id          String      @id @default(uuid(7)) @db.Uuid
  slug        String      @unique
  topicId     String      @map("topic_id") @db.Uuid
  question    String
  teaser      String
  body        String[]
  minutes     Int
  imageSrc    String      @map("image_src")
  imageAlt    String      @map("image_alt")
  status      BlockStatus @default(draft)
  publishedAt DateTime?   @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic      Topic             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  sources    BlockSource[]
  activities Activity[]
  concepts   BlockConcept[]
  saves      SavedBlock[]
  events     BlockEvent[]
  sessions   LearningSession[]

  // Feed keyset pagination: published blocks newest first.
  @@index([status, publishedAt(sort: Desc), id])
  @@index([topicId])
  @@map("learning_block")
}

model BlockSource {
  id        String @id @default(uuid(7)) @db.Uuid
  blockId   String @map("block_id") @db.Uuid
  position  Int
  title     String
  publisher String
  url       String

  block LearningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, position])
  @@map("block_source")
}

/// Concepts a block teaches; seeds the session's "In this session" list and Explore next.
model BlockConcept {
  blockId   String @map("block_id") @db.Uuid
  conceptId String @map("concept_id") @db.Uuid
  position  Int    @default(0)

  block   LearningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  concept Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([blockId, conceptId])
  @@index([conceptId])
  @@map("block_concept")
}

model SavedBlock {
  userId    String   @map("user_id")
  blockId   String   @map("block_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  block LearningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([userId, blockId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_block")
}

enum BlockEventKind {
  impression
  open
  read
  save
  unsave
  dismiss
  explore

  @@map("block_event_kind")
}

/// Append-only feed signals for personalisation. Respects `personalizeDiscover` at read time.
model BlockEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id")
  blockId   String         @map("block_id") @db.Uuid
  kind      BlockEventKind
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  block LearningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([blockId])
  @@map("block_event")
}

// ─── Activities (Interact) ────────────────────────────────────────────────────────────────────

enum ActivityKind {
  predict
  order
  simulate

  @@map("activity_kind")
}

enum ActivityOrigin {
  authored
  generated

  @@map("activity_origin")
}

/// Structured activity data rendered by approved React components. `spec` matches the
/// kind's Pydantic/TypeScript schema (options, answer, bands…) and is validated before insert.
model Activity {
  id        String         @id @default(uuid(7)) @db.Uuid
  kind      ActivityKind
  origin    ActivityOrigin
  title     String
  prompt    String
  spec      Json
  /// Authored activities hang off a block; generated ones off the session Mira made them in.
  blockId   String?        @map("block_id") @db.Uuid
  sessionId String?        @map("session_id") @db.Uuid
  model     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  block    LearningBlock?    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  session  LearningSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts ActivityAttempt[]

  @@index([blockId])
  @@index([sessionId])
  @@map("activity")
}

enum AttemptOutcome {
  solved
  retried
  skipped

  @@map("attempt_outcome")
}

model ActivityAttempt {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id")
  activityId String         @map("activity_id") @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  outcome    AttemptOutcome
  response   Json
  correct    Boolean?
  note       String?
  /// Client-generated key so retried submissions never double count.
  clientId   String         @map("client_id")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  session  LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([sessionId, createdAt])
  @@map("activity_attempt")
}

// ─── Learning sessions (Explore with Mira) ────────────────────────────────────────────────────

enum SessionStatus {
  active
  finished
  abandoned

  @@map("session_status")
}

/// One conversation with Mira, started from a block or from "Ask Mira anything" (no block).
model LearningSession {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id")
  blockId        String?       @map("block_id") @db.Uuid
  title          String
  status         SessionStatus @default(active)
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(3)
  /// Active speaking/typing time, not wall-clock time between start and end.
  activeSeconds  Int           @default(0) @map("active_seconds")
  messageCount   Int           @default(0) @map("message_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  block      LearningBlock?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  messages   SessionMessage[]
  activities Activity[]
  attempts   ActivityAttempt[]
  concepts   SessionConcept[]
  evidence   ConceptEvidence[]
  recaps     Recap[]
  recall     RecallItem[]
  memories   LearnerMemory[]
  aiUsage    AiUsage[]

  @@index([userId, lastActivityAt(sort: Desc)])
  @@index([userId, blockId])
  @@map("learning_session")
}

enum MessageRole {
  mira
  learner

  @@map("message_role")
}

enum MessageVia {
  voice
  text

  @@map("message_via")
}

/// Transcript turns. Voice turns store the final transcription; audio is never persisted.
model SessionMessage {
  id          String      @id @default(uuid(7)) @db.Uuid
  sessionId   String      @map("session_id") @db.Uuid
  seq         Int
  role        MessageRole
  via         MessageVia
  text        String
  /// Idempotency key: the browser's message id or the Live API turn id.
  clientId    String      @map("client_id")
  /// Set when Mira was interrupted mid-reply; `text` is what was actually spoken.
  interrupted Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@unique([sessionId, clientId])
  @@map("session_message")
}

enum RecapStatus {
  generating
  ready
  failed

  @@map("recap_status")
}

/// Versioned recap. "No recap yet" is the absence of a row; regenerating adds a version.
model Recap {
  id            String      @id @default(uuid(7)) @db.Uuid
  sessionId     String      @map("session_id") @db.Uuid
  version       Int
  status        RecapStatus @default(generating)
  summary       String?
  /// [{ title, text }]
  keyIdeas      Json?       @map("key_ideas")
  openQuestions String[]    @map("open_questions")
  nextSteps     String[]    @map("next_steps")
  model         String?
  error         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(3)

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@map("recap")
}

// ─── Concepts and the learning graph ──────────────────────────────────────────────────────────

/// Canonical, shared concept. Learners never write here directly: extraction dedupes against
/// existing concepts by slug, then by embedding similarity, before creating a new one.
model Concept {
  id             String                       @id @default(uuid(7)) @db.Uuid
  slug           String                       @unique
  label          String
  summary        String
  topicId        String?                      @map("topic_id") @db.Uuid
  /// Embedding of "label: summary". Dimension is fixed by the configured embedding model;
  /// changing models means a new column/migration plus a reindex job, tracked by `embeddingModel`.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  embeddedAt     DateTime?                    @map("embedded_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic       Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  blocks      BlockConcept[]
  learners    UserConcept[]
  sessions    SessionConcept[]
  evidence    ConceptEvidence[]
  edgesFrom   ConceptEdge[]     @relation("edge_from")
  edgesTo     ConceptEdge[]     @relation("edge_to")
  recallItems RecallItem[]
  memories    LearnerMemory[]

  // The migration adds: CREATE INDEX ... USING hnsw (embedding vector_cosine_ops);
  // Prisma can't model it, so `migrate dev` will propose DROP INDEX "concept_embedding_hnsw_idx":
  // delete that line from any generated migration (use --create-only and review).
  @@index([topicId])
  @@map("concept")
}

enum ConceptEdgeKind {
  semantic
  prerequisite

  @@map("concept_edge_kind")
}

/// Global relation between two canonical concepts, stored once with fromId < toId for
/// `semantic` (undirected). A learner's graph is the subgraph whose ends they both know;
/// "same session" links are derived from SessionConcept, not stored.
model ConceptEdge {
  fromId     String          @map("from_id") @db.Uuid
  toId       String          @map("to_id") @db.Uuid
  kind       ConceptEdgeKind
  /// Cosine similarity at the time of linking (semantic edges).
  similarity Float?          @db.Real
  rationale  String
  model      String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  from Concept @relation("edge_from", fields: [fromId], references: [id], onDelete: Cascade)
  to   Concept @relation("edge_to", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, kind])
  @@index([toId])
  @@map("concept_edge")
}

/// Evidence ladder. Exposure alone never becomes `demonstrated`.
enum ConceptState {
  discussed
  practiced
  demonstrated

  @@map("concept_state")
}

/// A learner's standing on a concept: a cache of the strongest evidence, rebuilt from
/// ConceptEvidence. The graph and "N concepts" read from here.
model UserConcept {
  userId         String       @map("user_id")
  conceptId      String       @map("concept_id") @db.Uuid
  state          ConceptState
  firstSeenAt    DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastEvidenceAt DateTime     @default(now()) @map("last_evidence_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([userId, conceptId])
  @@index([conceptId])
  @@map("user_concept")
}

/// "In this session": concepts touched in one session and the state reached there.
model SessionConcept {
  sessionId String       @map("session_id") @db.Uuid
  conceptId String       @map("concept_id") @db.Uuid
  state     ConceptState
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  concept Concept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([sessionId, conceptId])
  @@index([conceptId])
  @@map("session_concept")
}

enum EvidenceKind {
  discussed
  practiced
  demonstrated
  missed

  @@map("evidence_kind")
}

enum EvidenceSource {
  message
  activity
  recall

  @@map("evidence_source")
}

/// Append-only audit of why a learner holds a state, pointing at the message, attempt or
/// review that justified it. Recomputing UserConcept from this table must be deterministic.
model ConceptEvidence {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id")
  conceptId String         @map("concept_id") @db.Uuid
  sessionId String?        @map("session_id") @db.Uuid
  kind      EvidenceKind
  source    EvidenceSource
  /// Id of the SessionMessage, ActivityAttempt or RecallReview, per `source`.
  sourceId  String         @map("source_id") @db.Uuid
  note      String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([conceptId, source, sourceId, kind])
  @@index([userId, conceptId, createdAt])
  @@index([sessionId])
  @@map("concept_evidence")
}

// ─── Active recall ────────────────────────────────────────────────────────────────────────────

enum RecallState {
  new
  learning
  review
  relearning
  retired

  @@map("recall_state")
}

/// A recall card plus its FSRS-style schedule. The queue is `state <> retired AND due_at <= now()`.
model RecallItem {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @map("user_id")
  conceptId       String      @map("concept_id") @db.Uuid
  sessionId       String?     @map("session_id") @db.Uuid
  question        String
  /// [{ id, label }]
  options         Json
  correctOptionId String      @map("correct_option_id")
  explanation     String
  model           String?
  state           RecallState @default(new)
  dueAt           DateTime    @default(now()) @map("due_at") @db.Timestamptz(3)
  stability       Float       @default(0)
  difficulty      Float       @default(0)
  reps            Int         @default(0)
  lapses          Int         @default(0)
  lastReviewedAt  DateTime?   @map("last_reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reviews RecallReview[]

  @@index([userId, state, dueAt])
  @@index([conceptId])
  @@map("recall_item")
}

enum ReviewOutcome {
  recalled
  missed

  @@map("review_outcome")
}

model RecallReview {
  id             String        @id @default(uuid(7)) @db.Uuid
  itemId         String        @map("item_id") @db.Uuid
  userId         String        @map("user_id")
  outcome        ReviewOutcome
  chosenOptionId String        @map("chosen_option_id")
  responseMs     Int?          @map("response_ms")
  /// The schedule before and after, so history can be replayed or the algorithm retuned.
  previousDueAt  DateTime      @map("previous_due_at") @db.Timestamptz(3)
  nextDueAt      DateTime      @map("next_due_at") @db.Timestamptz(3)
  clientId       String        @map("client_id")
  reviewedAt     DateTime      @default(now()) @map("reviewed_at") @db.Timestamptz(3)

  item RecallItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, reviewedAt(sort: Desc)])
  @@index([itemId])
  @@map("recall_review")
}

// ─── Learner memory ───────────────────────────────────────────────────────────────────────────

enum MemoryKind {
  interest
  misconception
  preference

  @@map("memory_kind")
}

/// What Mira remembers about the learner, always with visible evidence. Learners can delete
/// any item; misconceptions are only written when `rememberMisconceptions` is on.
model LearnerMemory {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @map("user_id")
  kind       MemoryKind
  text       String
  evidence   String
  sessionId  String?    @map("session_id") @db.Uuid
  conceptId  String?    @map("concept_id") @db.Uuid
  resolvedAt DateTime?  @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  concept Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
  @@map("learner_memory")
}

// ─── Operations ───────────────────────────────────────────────────────────────────────────────

enum AiTask {
  live_tutor
  text_tutor
  recap
  recall_generation
  activity_generation
  concept_extraction
  embedding

  @@map("ai_task")
}

/// Per-call AI usage ledger for cost control and budgets. Deleted with the user; roll up
/// aggregate reporting first if it must outlive accounts.
model AiUsage {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String?  @map("user_id")
  sessionId    String?  @map("session_id") @db.Uuid
  task         AiTask
  provider     String
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  audioSeconds Float    @default(0) @map("audio_seconds")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  dead

  @@map("job_status")
}

/// Durable background work (recaps, extraction, embeddings, recall generation) claimed by
/// FastAPI workers with `FOR UPDATE SKIP LOCKED`. Survives restarts; `dedupeKey` makes enqueue idempotent.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  kind        String
  payload     Json
  status      JobStatus @default(queued)
  dedupeKey   String?   @unique @map("dedupe_key")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("job")
}
