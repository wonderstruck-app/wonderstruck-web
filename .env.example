# Public URL of the app; Google redirects to <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Azure Database for PostgreSQL connection string (sslmode=require on Azure)
DATABASE_URL=postgres://user:password@host:5432/wonderstruck?sslmode=require
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FastAPI backend the UI reads from. Set NEXT_PUBLIC_WONDERSTRUCK_DATA=mock to use in-memory fixtures instead.
API_URL=http://localhost:8001
# Mira's voice socket connects straight to the API. Defaults to API_URL with ws(s)://; set it when the browser reaches the API at another address.
# NEXT_PUBLIC_API_WS_URL=wss://api.example.com
