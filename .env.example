# Public URL of the app; Google redirects to <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Azure Database for PostgreSQL connection string (sslmode=require on Azure)
DATABASE_URL=postgres://user:password@host:5432/wonderstruck?sslmode=require
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
